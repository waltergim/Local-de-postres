# Postgres (Neon)
DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# Panel admin: contraseña única
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Clave para firmar la cookie de sesión (usá un valor largo y aleatorio)
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Vercel Blob (se usa OIDC, no BLOB_READ_WRITE_TOKEN)
# En Vercel se inyectan solos. Para desarrollo local copiá los valores.
BLOB_STORE_ID="store_xxxxxxxxxxxxxxxxx"
VERCEL_OIDC_TOKEN=""

# URL pública del sitio para disparar la revalidación de caché al editar
PUBLIC_SITE_URL="https://tu-sitio.vercel.app"
REVALIDATE_SECRET="un-secreto-largo-compartido-con-el-sitio"
